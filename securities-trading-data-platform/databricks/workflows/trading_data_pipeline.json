{
  "name": "securities_trading_data_pipeline",
  "description": "End-to-end medallion architecture pipeline for securities trading data. Ingests raw data from S3, transforms through bronze → silver → gold layers.",
  "email_notifications": {
    "on_failure": ["data-platform-alerts@company.com"]
  },
  "schedule": {
    "quartz_cron_expression": "0 0 18 ? * MON-FRI",
    "timezone_id": "America/New_York",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "setup_catalog",
      "description": "Ensure Unity Catalog, schemas, and volumes exist",
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/00_setup/setup_catalog",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 300
    },
    {
      "task_key": "bronze_instruments",
      "description": "Ingest instrument reference data to bronze",
      "depends_on": [{"task_key": "setup_catalog"}],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/01_bronze/ingest_instruments",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 600
    },
    {
      "task_key": "bronze_trades",
      "description": "Ingest trade data to bronze via Auto Loader",
      "depends_on": [{"task_key": "setup_catalog"}],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/01_bronze/ingest_trades",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "bronze_orders",
      "description": "Ingest order data to bronze via Auto Loader",
      "depends_on": [{"task_key": "setup_catalog"}],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/01_bronze/ingest_orders",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "bronze_market_data",
      "description": "Ingest market data to bronze via Auto Loader",
      "depends_on": [{"task_key": "setup_catalog"}],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/01_bronze/ingest_market_data",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 3600
    },
    {
      "task_key": "bronze_positions",
      "description": "Ingest position snapshots to bronze via Auto Loader",
      "depends_on": [{"task_key": "setup_catalog"}],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/01_bronze/ingest_positions",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1200
    },
    {
      "task_key": "silver_instruments",
      "description": "Transform instruments to silver (must run before other silver tasks)",
      "depends_on": [{"task_key": "bronze_instruments"}],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/02_silver/transform_instruments",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 600
    },
    {
      "task_key": "silver_trades",
      "description": "Transform trades to silver (enriched with instrument data)",
      "depends_on": [
        {"task_key": "bronze_trades"},
        {"task_key": "silver_instruments"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/02_silver/transform_trades",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "silver_orders",
      "description": "Transform orders to silver",
      "depends_on": [
        {"task_key": "bronze_orders"},
        {"task_key": "silver_instruments"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/02_silver/transform_orders",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "silver_market_data",
      "description": "Transform market data to silver with technical indicators",
      "depends_on": [{"task_key": "bronze_market_data"}],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/02_silver/transform_market_data",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 3600
    },
    {
      "task_key": "silver_positions",
      "description": "Transform positions to silver",
      "depends_on": [
        {"task_key": "bronze_positions"},
        {"task_key": "silver_instruments"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/02_silver/transform_positions",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1200
    },
    {
      "task_key": "gold_daily_pnl",
      "description": "Compute daily P&L analytics",
      "depends_on": [
        {"task_key": "silver_trades"},
        {"task_key": "silver_positions"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/03_gold/daily_pnl",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "gold_trading_volume",
      "description": "Compute trading volume analytics",
      "depends_on": [{"task_key": "silver_trades"}],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/03_gold/trading_volume_analytics",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "gold_portfolio_summary",
      "description": "Compute portfolio summary and sector allocation",
      "depends_on": [
        {"task_key": "silver_positions"},
        {"task_key": "silver_trades"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/03_gold/portfolio_summary",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1200
    },
    {
      "task_key": "gold_risk_metrics",
      "description": "Compute risk metrics (VaR, concentration, trader risk)",
      "depends_on": [
        {"task_key": "silver_trades"},
        {"task_key": "silver_positions"},
        {"task_key": "silver_market_data"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/03_gold/risk_metrics",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1800
    },
    {
      "task_key": "gold_market_analytics",
      "description": "Compute market analytics (daily summary, sector perf, liquidity)",
      "depends_on": [
        {"task_key": "silver_market_data"},
        {"task_key": "silver_instruments"}
      ],
      "notebook_task": {
        "notebook_path": "/Repos/securities-trading-data-platform/databricks/notebooks/03_gold/market_analytics",
        "source": "GIT"
      },
      "job_cluster_key": "pipeline_cluster",
      "timeout_seconds": 1800
    }
  ],
  "job_clusters": [
    {
      "job_cluster_key": "pipeline_cluster",
      "new_cluster": {
        "spark_version": "14.3.x-scala2.12",
        "node_type_id": "i3.xlarge",
        "num_workers": 2,
        "autoscale": {
          "min_workers": 1,
          "max_workers": 4
        },
        "spark_conf": {
          "spark.databricks.delta.optimizeWrite.enabled": "true",
          "spark.databricks.delta.autoCompact.enabled": "true",
          "spark.sql.adaptive.enabled": "true"
        },
        "aws_attributes": {
          "instance_profile_arn": "arn:aws:iam::instance-profile/databricks-s3-access",
          "availability": "SPOT_WITH_FALLBACK",
          "zone_id": "auto"
        },
        "custom_tags": {
          "Project": "securities-trading-data-platform",
          "Pipeline": "medallion"
        }
      }
    }
  ],
  "tags": {
    "project": "securities-trading-data-platform",
    "team": "data-engineering"
  }
}
